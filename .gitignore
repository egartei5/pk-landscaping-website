# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
# testing
/coverage
# next.js
/.next/
/out/
# production
/build
# misc
.DS_Store
*.pem
# macOS AppleDouble metadata (created on non-HFS volumes, e.g. exFAT drives)
._*
.AppleDouble
.Spotlight-V100
.Trashes
# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# local env files
.env*.local
# vercel
.vercel
# typescript
*.tsbuildinfo
next-env.d.ts
# Database files — never commit
prisma/**/*.db
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal
# Superpowers brainstorm files
.superpowers/