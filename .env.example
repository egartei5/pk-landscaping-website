# Copy this to .env.local and fill in your values

# Database (SQLite — update path for production)
DATABASE_URL="file:./prisma/prod.db"

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-strong-random-secret-here"
NEXTAUTH_URL="https://yourdomain.com"

# Email (Gmail App Password — not your regular password)
# Enable 2FA on Gmail, then: Google Account > Security > App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
NOTIFICATION_EMAIL="your-email@gmail.com"

# Admin account (used only during initial db:seed)
ADMIN_SEED_EMAIL="admin@yoursite.com"
ADMIN_SEED_PASSWORD="StrongPassword123!"
