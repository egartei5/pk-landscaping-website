# Copy this to .env.local and fill in your values

# Database — PostgreSQL only.
# SQLite is NOT supported: Railway containers are ephemeral, so a SQLite file
# is destroyed (along with every lead, booking and blog post) on each deploy.
# On Railway use a reference to the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/pk_landscaping"

# Redis — backs the API rate limiter so limits hold across instances.
# On Railway use a reference to the Redis service: ${{Redis.REDIS_URL}}
# If unset, rate limiting degrades to per-process memory (fine for local dev).
REDIS_URL="redis://localhost:6379"

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-strong-random-secret-here"
NEXTAUTH_URL="https://yourdomain.com"

# Email — Resend HTTPS is recommended on Railway Hobby, which blocks SMTP.
RESEND_API_KEY="re_your_api_key"
RESEND_FROM_EMAIL="contact@yourdomain.com"
NOTIFICATION_EMAIL="your-email@gmail.com"

# Optional SMTP fallback for hosts/plans that permit outbound SMTP.
# For Gmail, enable 2FA and use an App Password rather than your regular password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Admin account — created by scripts/bootstrap.mjs on first boot if absent
ADMIN_SEED_EMAIL="admin@yoursite.com"
ADMIN_SEED_PASSWORD="StrongPassword123!"
